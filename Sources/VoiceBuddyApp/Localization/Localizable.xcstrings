    "Voice Buddy is fully ready for offline dictation and insertion.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice Buddy is fully ready for offline dictation and insertion."
          }
        },
