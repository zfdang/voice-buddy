    "100% Offline: Models run directly on Apple Silicon via Metal / Core ML with zero network dependencies during dictation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "100% Offline: Models run directly on Apple Silicon via Metal / Core ML with zero network dependencies during dictation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "100% 本地离线：听写和文本整理直接在芯片上运行，听写过程断网可用。"
          }
        }
      }
    },
